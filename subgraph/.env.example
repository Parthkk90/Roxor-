# Copy to `subgraph/.env` and fill in. That file is gitignored; this one is not, so never put a
# real key here.

# Graph Studio deploy key (Studio -> your subgraph -> "Auth & Deploy"). Grants publish rights.
GRAPH_DEPLOY_KEY=
# Studio subgraph slug, e.g. `v-1-1-inch`.
GRAPH_SUBGRAPH_SLUG=
# Query API key for the decentralised gateway. Read-only, but still billable - treat as a secret.
GRAPH_QUERY_API_KEY=
