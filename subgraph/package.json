{
  "name": "conditional-liquidity-subgraph",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Discovery index for the Conditional Liquidity Marketplace. Layer 1 of three: never a settlement input.",
  "scripts": {
    "sync-abis": "node scripts/sync-abis.mjs",
    "codegen": "graph codegen",
    "build": "graph codegen && graph build",
    "auth": "graph auth $GRAPH_DEPLOY_KEY",
    "deploy": "graph deploy $GRAPH_SUBGRAPH_SLUG --version-label $npm_package_version",
    "create-local": "graph create --node http://localhost:8020/ conditional-liquidity",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 conditional-liquidity"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.97.1",
    "@graphprotocol/graph-ts": "0.38.1"
  }
}
