# RPC endpoint used for fork tests and deployments.
# A free public endpoint that works for this: https://ethereum-rpc.publicnode.com
RPC_URL=

# Pin fork tests to a specific block so runs are reproducible.
#
# IMPORTANT: free-tier public RPCs (e.g. ethereum-rpc.publicnode.com) reject ANY explicit block
# number with "Archive requests require a personal token" -- even a block just 100 behind the
# tip. Only unpinned ("latest") queries are served for free. Verified directly: FORK_BLOCK set to
# the current tip, or to tip-100, both failed with HTTP 403; leaving FORK_BLOCK unset (fork at
# latest) succeeded. If you're using such an endpoint, leave this blank -- the fork test already
# falls back to `vm.createSelectFork(rpcUrl)` (latest) when FORK_BLOCK is 0/unset, so it still
# runs, just not pinned to an exact block across runs.
#
# If you have an archive-capable RPC (Alchemy/Infura/your own archive node), set this to pin an
# exact block for reproducibility, e.g.:
# FORK_BLOCK=25909900
FORK_BLOCK=

# Deployer key. NEVER commit a real key.
PRIVATE_KEY=

ETHERSCAN_API_KEY=
