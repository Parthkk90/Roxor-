# Get an App ID at https://dashboard.privy.io (free) — create an app, allow embedded + external
# wallets, and add Sepolia to its allowed chains.
VITE_PRIVY_APP_ID=

# Optional: override the default public Sepolia RPC.
VITE_RPC_URL=

# Optional: The Graph query endpoint used for historical reliability in the marketplace table.
# Studio:  https://api.studio.thegraph.com/query/<ACCOUNT_ID>/<SLUG>/version/latest
# Gateway: https://gateway.thegraph.com/api/<API_KEY>/subgraphs/id/<SUBGRAPH_ID>
# Leave blank to run without it — reliability then renders as "-" rather than a made-up number.
VITE_SUBGRAPH_URL=
